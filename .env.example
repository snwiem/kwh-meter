# Path to the mandatory meter JSON configuration file.
# Copy meter-config.example.json to meter-config.json, fill in your
# meter details, and set this variable to its path.
#
# Example (used automatically by docker-compose.yml):
# KWH_METER_CONFIG=/config/meter.json
KWH_METER_CONFIG=

# PostgreSQL connection URL (used by the backend and Alembic).
# The docker-compose default is already set inside docker-compose.yml.
# Override here only if you run the backend outside of Docker.
# DATABASE_URL=postgresql+asyncpg://kwh:kwh@localhost:5432/kwh
